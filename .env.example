# Core
APP_URL=http://localhost:5173
DATABASE_URL=postgres://structflow:structflow@localhost:5432/structflow
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# S3-compatible object storage (MinIO defaults for docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=structflow
S3_ACCESS_KEY=structflow
S3_SECRET_KEY=structflow-secret
S3_FORCE_PATH_STYLE=true

# Billing (optional until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Google Sheets export (optional service-account JSON, one line)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Operational controls
FREE_MONTHLY_PAGES=50
MAX_FILE_SIZE_MB=20
DATA_RETENTION_DAYS=30
WORKER_CONCURRENCY=3
LOG_LEVEL=info
